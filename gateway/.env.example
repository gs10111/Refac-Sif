# TEMPLATE. Copie para gateway/.env — que é git-ignored — e preencha.
# Este repositório é PÚBLICO: nada preenchido aqui pode ser commitado.

# Broker local para onde o servidor TCP publica as capturas.
SIF_MQTT_ENABLED=1
SIF_MQTT_HOST=127.0.0.1
SIF_MQTT_PORT=1883

# Prefixo dos tópicos. O gateway assina <prefixo>/telemetry/+ e <prefixo>/burst/+
# (ver mqtt.json) — mudar aqui exige mudar lá.
SIF_MQTT_TOPIC_PREFIX=sif

# Amostras por mensagem. 100 dá ~13 KB, dentro do max_packet_size do broker.
SIF_MQTT_CHUNK_SIZE=100
