{
  "broker": {
    "name": "Mosquitto local SIF",
    "host": "127.0.0.1",
    "port": 1883,
    "clientId": "tb-gateway-sif",
    "version": 5,
    "security": {
      "type": "anonymous"
    }
  },
  "mapping": [
    {
      "topicFilter": "sif/telemetry/+",
      "subscriptionQos": 1,
      "converter": {
        "type": "custom",
        "extension": "SifBurstConverter",
        "extension-config": {}
      }
    },
    {
      "topicFilter": "sif/burst/+",
      "subscriptionQos": 1,
      "converter": {
        "type": "custom",
        "extension": "SifBurstConverter",
        "extension-config": {}
      }
    }
  ],
  "connectRequests": [],
  "disconnectRequests": [],
  "attributeRequests": [],
  "attributeUpdates": [],
  "serverSideRpc": []
}
