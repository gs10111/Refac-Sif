{
  "_comment": [
    "TEMPLATE. Copie para tb_gateway.json e preencha host e accessToken.",
    "tb_gateway.json é git-ignored: o accessToken é credencial e este",
    "repositório é PÚBLICO. Nunca commite o arquivo preenchido."
  ],
  "thingsboard": {
    "host": "PREENCHA-O-HOST-DO-THINGSBOARD",
    "port": 8883,
    "remoteShell": false,
    "remoteConfiguration": false,
    "security": {
      "accessToken": "PREENCHA-O-ACCESS-TOKEN-DO-GATEWAY"
    },
    "qos": 1,
    "tls": {
      "enabled": true,
      "caCert": "/thingsboard_gateway/ca.pem"
    }
  },
  "storage": {
    "type": "file",
    "data_folder_path": "/thingsboard_gateway/data/",
    "max_file_count": 100,
    "max_read_records_count": 100,
    "max_records_per_file": 10000
  },
  "connectors": [
    {
      "name": "MQTT SIF",
      "type": "mqtt",
      "configuration": "mqtt.json"
    }
  ]
}
